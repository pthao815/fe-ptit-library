# Che do ket noi API: "local" | "remote"
VITE_API_TARGET=local

# URL Backend khi chay local
VITE_API_LOCAL_URL=http://localhost:8080

# URL Backend sau khi deploy (cap nhat khi co server deploy)
VITE_API_REMOTE_URL=http://localhost:8080

# Timeout cho HTTP request (ms)
VITE_API_TIMEOUT=30000

# Microsoft Entra ID (OIDC PKCE cho dang nhap tai khoan truong PTIT)
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_AUTHORITY=https://login.microsoftonline.com/organizations
VITE_MICROSOFT_REDIRECT_URI=
